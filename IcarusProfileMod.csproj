<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>IcarusProfileMod</AssemblyName>
    <RootNamespace>IcarusProfileMod</RootNamespace>
    <Version>1.1.1</Version>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <FileVersion>1.1.1.0</FileVersion>
    <InformationalVersion>1.1.1</InformationalVersion>
    <Authors>sickprodigy</Authors>
    <Company>sickprodigy</Company>
    <Product>Icarus Profile Mod</Product>
    <PackageProjectUrl>https://sickgaming.net/</PackageProjectUrl>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="Author" Value="$(Authors)" />
    <AssemblyMetadata Include="Website" Value="$(PackageProjectUrl)" />
  </ItemGroup>

  <ItemGroup>
    <None Update="data\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyBundledDataToPublish" AfterTargets="Publish">
    <ItemGroup>
      <BundledData Include="data\*.json" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)data" />
    <Copy SourceFiles="@(BundledData)" DestinationFolder="$(PublishDir)data" SkipUnchangedFiles="false" />
  </Target>
</Project>

